
<?xml version="1.0"?>
<robot>
<gazebo reference="base_link">
<mu1>0.2</mu1>
<mu2>0.2</mu2>
<material>Gazebo/Black</material>
</gazebo>

<gazebo reference="right_wheel_back">
<mu1>0.2</mu1>
<mu2>0.2</mu2>
<material>Gazebo/Yellow</material>
</gazebo>

<gazebo reference="right_wheel_front">
<mu1>0.2</mu1>
<mu2>0.2</mu2>
<material>Gazebo/Yellow</material>
</gazebo>

<gazebo reference="left_wheel_back">
<mu1>0.2</mu1>
<mu2>0.2</mu2>
<material>Gazebo/Yellow</material>
</gazebo>

<gazebo reference="left_wheel_front">
<mu1>0.2</mu1>
<mu2>0.2</mu2>
<material>Gazebo/Yellow</material>
</gazebo>


<!--Controller for the four wheeled robot-->

<gazebo>

<plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
    <left_joint>left_wheel_joint_front</left_joint>
    <left_joint>left_wheel_joint_back</left_joint>
    <right_joint>right_wheel_joint_front</right_joint>
    <right_joint>right_wheel_joint_back</right_joint>
    <wheel_separation>${bred+wheel_length}</wheel_separation>
    <wheel_radius>${wheel_radius}</wheel_radius>
    <topic>/cmd_vel</topic>
    <odom_publish_frequency>50</odom_publish_frequency>
    <odom_frame>odom</odom_frame>
    <robot_base_frame>base_link</robot_base_frame>
</plugin>

  <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    <topic>joint_states</topic>
    <joint_name>right_wheel_joint_front</joint_name>
    <joint_name>left_wheel_joint_front</joint_name>
  </plugin>

</gazebo>

</robot>
